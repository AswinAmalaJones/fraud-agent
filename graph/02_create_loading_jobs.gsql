USE GRAPH fraudGraph

CREATE LOADING JOB load_customers FOR GRAPH fraudGraph {
  DEFINE FILENAME f;
  LOAD f TO VERTEX Customer VALUES ($0, $1) USING SEPARATOR="\t", HEADER="false", EOL="\n";
}
CREATE LOADING JOB load_cards FOR GRAPH fraudGraph {
  DEFINE FILENAME f;
  LOAD f TO VERTEX Card VALUES ($0, $1, $2, gsql_to_bool($3), gsql_to_bool($4), gsql_to_bool($5)) USING SEPARATOR="\t", HEADER="false", EOL="\n";
}
CREATE LOADING JOB load_device_profiles FOR GRAPH fraudGraph {
  DEFINE FILENAME f;
  LOAD f TO VERTEX DeviceProfile VALUES ($0, $1, $2, $3, $4, $5) USING SEPARATOR="\t", HEADER="false", EOL="\n";
}
CREATE LOADING JOB load_billing_regions FOR GRAPH fraudGraph {
